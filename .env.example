# ==============================================================================
# ZYORA LUXURY E-COMMERCE PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env or configure these variables in Vercel Project Settings.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Neon connection string with connection pooling enabled:
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/zyora?sslmode=require"

# Direct connection string for Prisma CLI migrations (optional, non-pooled):
DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/zyora?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Strong random secret key for JWT signing & verification (min 32 chars):
JWT_SECRET="generate-a-secure-random-secret-key-for-jwt-signing-min-32-chars"

# Base URL of the deployment:
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment: 'development' or 'production'
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Server-side Razorpay API credentials:
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"

# Client-safe Razorpay Key ID for checkout modal:
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"

# ------------------------------------------------------------------------------
# 4. REAL WHATSAPP & SMS OTP AUTHENTICATION PROVIDERS
# ------------------------------------------------------------------------------
# Default channel is WhatsApp. Provider auto-detects based on available keys,
# or specify explicitly: 'whatsapp', 'meta_whatsapp', 'twilio_whatsapp', 'msg91_whatsapp', 'twilio', 'fast2sms', 'resend'
OTP_PROVIDER="whatsapp"

# Option A: Meta WhatsApp Cloud API (Recommended for official WhatsApp OTP)
# Get credentials from Meta for Developers (Graph API): https://developers.facebook.com/
WHATSAPP_ACCESS_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# WHATSAPP_TEMPLATE_NAME="zyora_auth_otp" # Optional: Leave blank to use direct session messages

# Option B: Twilio WhatsApp API
# Get credentials from Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_WHATSAPP_FROM="+14155238886" # Or your approved Twilio WhatsApp Sender

# Option C: MSG91 WhatsApp
# Get credentials from MSG91: https://msg91.com
MSG91_AUTH_KEY="xxxxxxxxxxxxxxxxxxxx"
MSG91_WHATSAPP_INTEGRATED_NUMBER="91xxxxxxxxxx"
MSG91_WHATSAPP_TEMPLATE_NAME="zyora_otp"

# Fallback SMS Providers (Optional)
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
FAST2SMS_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="auth@zyora.com"

# Local Development / Automated Testing Flag ONLY (never set to 'true' in production):
# ALLOW_MOCK_OTP="false"

# ------------------------------------------------------------------------------
# 5. ZYORA AI SHOPPING ASSISTANT & STYLING CONCIERGE (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API key for intelligent conversational styling.
# If omitted, Zyora AI uses its high-fidelity built-in catalog grounding engine.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
AI_API_KEY="AIzaSyYourGeminiApiKeyHere"

